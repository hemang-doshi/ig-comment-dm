{
  "name": "ig-comment-dm",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "setup:agent": "node --experimental-strip-types scripts/setup.ts --agent",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "update": "node --experimental-strip-types scripts/update.ts",
    "dev": "wrangler dev --port 8787",
    "deploy": "npm run build:web && npm run typecheck && vitest run && npm run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:list": "wrangler d1 migrations list DB --remote",
    "db:migrate:list:local": "wrangler d1 migrations list DB --local",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test scripts/test-unit.ts scripts/test-update.ts scripts/test-setup.ts",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "selftest": "node --experimental-strip-types scripts/selftest.ts",
    "keys": "node --experimental-strip-types scripts/keys.ts",
    "icons": "node --experimental-strip-types scripts/icons.ts",
    "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "build": "npm run build:web"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@msw/cloudflare": "0.2.0",
    "msw": "3.0.3",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "wrangler": "^4.153.0"
  },
  "description": "Self-hosted Instagram comment-to-DM automation on Cloudflare's free plan: one Worker, one D1 database, Meta's official API, and a dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemang-doshi/ig-comment-dm.git"
  },
  "bugs": {
    "url": "https://github.com/hemang-doshi/ig-comment-dm/issues"
  },
  "homepage": "https://github.com/hemang-doshi/ig-comment-dm#readme",
  "engines": {
    "node": ">=22.13"
  },
  "author": "Hemang Doshi (https://github.com/hemang-doshi)",
  "contributors": [
    "Charan MN (https://github.com/CharanMN7)"
  ],
  "keywords": [
    "cloudflare-d1",
    "cloudflare-workers",
    "comment-to-dm",
    "creator-tools",
    "dm-automation",
    "hono",
    "instagram",
    "instagram-api",
    "meta-graph-api",
    "react",
    "self-hosted"
  ]
}
